<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="YouJP" Width="1180" Height="850" MinWidth="880" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#0E0F13" FontFamily="Segoe UI" FontSize="14" Foreground="#F4F0E8" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <!-- Tema «Sumi», el mismo que la extensión: tinta, papel washi y un solo
       acento bermellón para lo que se puede pulsar o está activo. Dorado para
       traducción y verde para «listo». YouJP.ps1 aplica en tiempo de ejecución
       los colores de cada estado con estos mismos valores. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#0E0F13" />
    <SolidColorBrush x:Key="Surface" Color="#15161B" />
    <SolidColorBrush x:Key="Raised" Color="#1C1D23" />
    <SolidColorBrush x:Key="Inset" Color="#0B0C0F" />
    <SolidColorBrush x:Key="Line" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="LineStrong" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Paper" Color="#F4F0E8" />
    <SolidColorBrush x:Key="Muted" Color="#BDB7AD" />
    <SolidColorBrush x:Key="Faint" Color="#9A958C" />
    <SolidColorBrush x:Key="Shu" Color="#FF6A4D" />
    <SolidColorBrush x:Key="ShuDeep" Color="#D23A20" />
    <SolidColorBrush x:Key="ShuSoft" Color="#26FF6A4D" />
    <SolidColorBrush x:Key="Kin" Color="#F7D794" />
    <SolidColorBrush x:Key="Ok" Color="#73D69F" />

    <Style TargetType="ScrollBar">
      <!-- Solo la vertical lleva la barra fina; la horizontal conserva la del sistema. -->
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="8" />
          <Setter Property="MinWidth" Value="8" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True" Orientation="Vertical">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb MinHeight="24">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border x:Name="ThumbBar" Background="#33FFFFFF" Width="5" HorizontalAlignment="Center" CornerRadius="3" Margin="1,2" />
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ThumbBar" Property="Background" Value="#59FFFFFF" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Paper}" /></Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <!-- Atajos de teclado y etiquetas pequeñas. -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="#0AFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,8,6" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource Paper}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <!-- La alineación sale del botón: las filas del historial reciente van a la izquierda. -->
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <!-- Ratón y foco en el estilo, no en la plantilla: así cada variante elige sus colores. -->
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#4DFFFFFF" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FF6A4D" /></Trigger>
      </Style.Triggers>
    </Style>
    <!-- La acción principal, el único botón relleno de cada pantalla. Texto
         blanco sobre bermellón profundo: 4,8:1. -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource ShuDeep}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource ShuDeep}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E2462B" />
          <Setter Property="BorderBrush" Value="#E2462B" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFC9BD" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Shu}" />
      <Setter Property="Padding" Value="0,6,18,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="13" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#FF8B74" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="NavBorder" CornerRadius="9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <Grid>
                <!-- Marca bermellón de la pantalla actual, como en los paneles de la extensión. -->
                <Border x:Name="NavMarker" Width="3" CornerRadius="2" Margin="0,9" HorizontalAlignment="Left" Background="{StaticResource Shu}" Visibility="Hidden" />
                <ContentPresenter Margin="14,10,12,10" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#0DFFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource Paper}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#14FFFFFF" />
                <Setter TargetName="NavMarker" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{StaticResource Paper}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#FF6A4D" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavIcon" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Item" Padding="{TemplateBinding Padding}" CornerRadius="7" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Item" Property="Background" Value="#14FFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource Paper}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Shu}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Foreground" Value="{StaticResource Paper}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ChoiceBorder" Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="9" />
              <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" ClickMode="Press" Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                      <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#9A958C" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,8,35,8" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer MaxHeight="250" CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#4DFFFFFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#FF6A4D" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Desplegables propios: el chevrón gira al abrir, sin el círculo del sistema. -->
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{StaticResource Shu}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="0,4">
                      <StackPanel Orientation="Horizontal">
                        <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="2,0,11,0" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                        </Path>
                        <ContentPresenter VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#FF6A4D" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" TextElement.Foreground="{StaticResource Muted}" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Filas del historial: sin el azul del sistema; la seleccionada lleva la marca bermellón. -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Paper}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" CornerRadius="9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <Grid>
                <Border x:Name="RowMarker" Width="3" CornerRadius="2" Margin="0,10" HorizontalAlignment="Left" Background="{StaticResource Shu}" Visibility="Hidden" />
                <ContentPresenter Margin="{TemplateBinding Padding}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#0AFFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                <Setter TargetName="RowMarker" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="#FF6A4D" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Registro e historial: texto de solo lectura con selección bermellón. -->
    <Style x:Key="ReadOnlyText" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="SelectionBrush" Value="{StaticResource Shu}" />
      <Setter Property="CaretBrush" Value="{StaticResource Paper}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid ClipToBounds="True"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
          <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource Ink}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#111216" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="14,26,14,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Margin="6,0,0,30">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Image x:Name="BrandIcon" Width="42" Height="42" Margin="0,0,11,0" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Clip><RectangleGeometry Rect="0,0,42,42" RadiusX="11" RadiusY="11" /></Image.Clip>
              </Image>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="You" Foreground="{StaticResource Paper}" FontSize="25" FontWeight="Bold"/><TextBlock Text="JP" Foreground="{StaticResource Shu}" FontSize="25" FontWeight="Bold"/></StackPanel>
            </StackPanel>
            <TextBlock Text="JAPONÉS EN CONTEXTO" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}" />
          </StackPanel>
          <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="True" AutomationProperties.Name="Tu sesión">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M4,20 L4,11.5 L12,5 L20,11.5 L20,20 Z M9.5,20 L9.5,14.5 L14.5,14.5 L14.5,20" /></Canvas></Viewbox>
              <TextBlock Text="Tu sesión" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavHistory" Style="{StaticResource Nav}" GroupName="Navigation" AutomationProperties.Name="Historial">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M8.7,4.5 L17.3,4.5 A2.2,2.2 0 0 1 19.5,6.7 L19.5,17.3 A2.2,2.2 0 0 1 17.3,19.5 L8.7,19.5 M10.5,9.5 L15.5,9.5 M10.5,12.5 L15.5,12.5 M10.5,15.5 L13.5,15.5 M5.5,3.5 A2,2 0 0 1 7.5,5.5 L7.5,18.5 A2,2 0 0 1 3.5,18.5 L3.5,5.5 A2,2 0 0 1 5.5,3.5 Z" /></Canvas></Viewbox>
              <TextBlock Text="Historial" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavActivity" Style="{StaticResource Nav}" GroupName="Navigation" AutomationProperties.Name="Actividad">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M3,12 L6.5,12 L9,6 L13,18 L15.5,12 L21,12" /></Canvas></Viewbox>
              <TextBlock Text="Actividad" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <Border Height="1" Background="{StaticResource Line}" Margin="8,10,8,12" />
          <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="Navigation" AutomationProperties.Name="Configuración">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M4,6 L12.8,6 M17.2,6 L20,6 M4,12 L5.8,12 M10.2,12 L20,12 M4,18 L14.8,18 M19.2,18 L20,18 M17.2,6 A2.2,2.2 0 1 1 12.8,6 A2.2,2.2 0 1 1 17.2,6 M10.2,12 A2.2,2.2 0 1 1 5.8,12 A2.2,2.2 0 1 1 10.2,12 M19.2,18 A2.2,2.2 0 1 1 14.8,18 A2.2,2.2 0 1 1 19.2,18" /></Canvas></Viewbox>
              <TextBlock Text="Configuración" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <!-- Sello decorativo: cede el sitio a la navegación en ventanas bajas. -->
        <TextBlock Grid.Row="1" Text="字" FontFamily="Yu Mincho" FontSize="120" Foreground="#0AFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap" ClipToBounds="True" />
        <StackPanel Grid.Row="2">
          <Border Background="#0AFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,13" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><Ellipse x:Name="SidebarDot" Fill="#9A958C" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" /><TextBlock x:Name="SidebarStatus" Text="Comprobando" Foreground="{StaticResource Paper}" FontWeight="SemiBold" FontSize="13" /></StackPanel>
              <TextBlock Text="Tu audio permanece en este equipo" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,7,0,0" LineHeight="17" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Faint}" FontSize="10" Margin="6,0,0,0" />
          <TextBlock x:Name="PreviewLabel" Text="VISTA PREVIA" Foreground="{StaticResource Shu}" FontSize="10" FontWeight="SemiBold" Margin="6,7,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="26,30,20,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,8,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageEyebrow" Text="今日の日本語  /  TU JAPONÉS DE HOY" Foreground="{StaticResource Shu}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock x:Name="PageTitle" Text="Tu espacio de japonés" FontWeight="SemiBold" FontSize="32" Foreground="{StaticResource Paper}" LineHeight="40" />
          <TextBlock x:Name="PageDescription" Text="Un poco de japonés. A tu ritmo." Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="14.5" />
        </StackPanel>
        <Border x:Name="StatusPill" Grid.Column="1" Background="#14FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="13,7" VerticalAlignment="Top" Margin="16,1,0,0">
          <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#9A958C" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock x:Name="StatusLabel" Text="Comprobando" FontSize="12" FontWeight="SemiBold" /></StackPanel>
        </Border>
      </Grid>
      <ScrollViewer x:Name="HomePage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,4">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14" ClipToBounds="True">
            <Grid x:Name="HeroSurface" MinHeight="268">
              <Grid.Background><ImageBrush x:Name="HeaderLandscape" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" /></Grid.Background>
              <!-- Tinta de izquierda a derecha: el texto se lee sobre tinta y el
                   paisaje queda en penumbra, sin deslumbrar en el tema oscuro. -->
              <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F70E0F13" Offset="0"/><GradientStop Color="#EB0E0F13" Offset="0.36"/><GradientStop Color="#A60E0F13" Offset="0.6"/><GradientStop Color="#6B0E0F13" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              <Image x:Name="MascotImage" Width="236" Height="252" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
              <Grid Margin="26,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <Border BorderBrush="#80FF6A4D" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,14"><TextBlock Text="今日の日本語" FontFamily="Yu Gothic UI" Foreground="{StaticResource Shu}" FontSize="11" FontWeight="SemiBold" /></Border>
                  <TextBlock x:Name="StatusTitle" Text="Preparando tu sesión." FontWeight="SemiBold" FontSize="30" LineHeight="38" Foreground="{StaticResource Paper}" />
                  <Border x:Name="StatusDetailBox" CornerRadius="10" Padding="0" Margin="0,10,0,16" MaxWidth="460" HorizontalAlignment="Left"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="StatusNoticeIcon" Background="{StaticResource ShuDeep}" CornerRadius="7" Width="26" Height="26" Margin="0,0,11,0" VerticalAlignment="Top" Visibility="Collapsed"><TextBlock Text="!" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock x:Name="StatusDetail" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="14" LineHeight="21" VerticalAlignment="Center" /></Grid></Border>
                  <WrapPanel><Button x:Name="PrimaryAction" Content="Iniciar YouJP" Style="{StaticResource Primary}" Padding="22,11" FontSize="14" Margin="0,0,10,0" /><Button x:Name="StopButton" Content="Detener" Visibility="Collapsed" /></WrapPanel>
                  <ProgressBar x:Name="BusyProgress" Height="2" IsIndeterminate="True" Foreground="{StaticResource Shu}" Background="#1AFFFFFF" BorderThickness="0" Visibility="Collapsed" Margin="0,12,10,0" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
          <UniformGrid Columns="3" Margin="0,0,0,14">
            <Border ToolTip="Transcripción" Style="{StaticResource Card}" Padding="14,14" Margin="0,0,6,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#14F4F0E8" CornerRadius="10" Width="38" Height="38" VerticalAlignment="Center">
                  <Path Data="M3,1 L17,1 L17,23 L3,23 Z M6,6 L14,6 M6,10 L14,10 M6,14 L12,14" Stroke="{StaticResource Paper}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Transcripción" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                  <TextBlock x:Name="ModelValue" Text="Por iniciar" FontSize="13.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
            <Border ToolTip="Procesamiento" Style="{StaticResource Card}" Padding="14,14" Margin="3,0,3,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource ShuSoft}" CornerRadius="10" Width="38" Height="38" VerticalAlignment="Center">
                  <Path Data="M14,1 L3,14 L10,14 L7,25 L20,10 L13,10 Z" Stroke="{StaticResource Shu}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Procesamiento" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                  <TextBlock x:Name="DeviceValue" Text="Automático" FontSize="13.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
            <Border ToolTip="Traducción" Style="{StaticResource Card}" Padding="14,14" Margin="6,0,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#1FF7D794" CornerRadius="10" Width="38" Height="38" VerticalAlignment="Center">
                  <TextBlock Text="文" FontFamily="Yu Mincho" Foreground="{StaticResource Kin}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Traducción" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                  <TextBlock x:Name="TranslationValue" Text="Por iniciar" FontSize="13.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="22,18">
              <StackPanel>
                <Grid><TextBlock Text="Tu sesión" FontWeight="SemiBold" FontSize="19" /><Border Background="#0FFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="SessionProgress" Text="0 de 2 pasos" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" /></Border></Grid>
                <ProgressBar x:Name="SessionProgressBar" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="2" Value="0" Height="4" Foreground="{StaticResource Shu}" Background="#14FFFFFF" Margin="0,14,0,0" />
                <Border x:Name="GuideSection" Background="Transparent" Margin="0,18,0,0">
                  <StackPanel>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="01" Foreground="{StaticResource Shu}" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,1,0,0" />
                      <StackPanel Grid.Column="1"><TextBlock Text="Abre algo que te guste" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Un vídeo, una entrevista o un directo en japonés." Foreground="{StaticResource Faint}" FontSize="12" LineHeight="18" Margin="0,4,0,0" /></StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="02" Foreground="{StaticResource Shu}" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,1,0,0" />
                      <StackPanel Grid.Column="1"><TextBlock Text="Activa YouJP en el navegador" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Pulsa su icono para empezar. Vuelve a pulsarlo para detener la captura." Foreground="{StaticResource Faint}" FontSize="12" LineHeight="18" Margin="0,4,0,0" /></StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="03" Foreground="{StaticResource Kin}" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,1,0,0" />
                      <StackPanel Grid.Column="1"><TextBlock Text="Traduce un vídeo entero" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="En vídeos que no son directos, pulsa el botón de subtítulos junto al reloj de YouTube: YouJP los traduce de antemano." Foreground="{StaticResource Faint}" FontSize="12" LineHeight="18" Margin="0,4,0,0" /></StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,16,0,0">
                      <Border Style="{StaticResource Chip}"><TextBlock Text="Alt + S  ajustes" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" /></Border>
                      <Border Style="{StaticResource Chip}"><TextBlock Text="Alt + H  historial" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" /></Border>
                      <Border Style="{StaticResource Chip}" Margin="0,0,0,6"><TextBlock Text="Alt + Mayús + S  traducir una zona" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" /></Border>
                    </WrapPanel>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,11,0,0">
                      <Expander x:Name="GuideExpander" Header="¿Primera vez con la extensión?" FontSize="12.5">
                        <StackPanel Margin="20,12,0,0">
                          <TextBlock Text="Abre la página de extensiones de Chrome, Edge o Brave. Activa Modo de desarrollador, elige Cargar descomprimida y selecciona la carpeta de YouJP." Foreground="{StaticResource Muted}" LineHeight="20" />
                          <TextBlock Text="Si acabas de actualizarla, pulsa Recargar en esa misma página y recarga YouTube." Foreground="{StaticResource Muted}" Margin="0,8,0,13" LineHeight="20" />
                          <Button x:Name="ExtensionFolder" Content="Abrir carpeta de la extensión" HorizontalAlignment="Left" FontSize="12.5" />
                          <TextBlock Text="En YouTube: Alt + S abre los ajustes; Alt + H, el historial; Alt + Mayús + S traduce una zona de la pantalla. Pulsa una palabra para explorarla." Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,13,0,0" LineHeight="17" />
                        </StackPanel>
                      </Expander>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18" ClipToBounds="True">
              <Grid>
                <TextBlock Text="記" FontFamily="Yu Mincho" FontSize="110" Foreground="#0DFF6A4D" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-30" IsHitTestVisible="False" TextWrapping="NoWrap" />
                <StackPanel>
                  <TextBlock Text="Actividad reciente" FontWeight="SemiBold" FontSize="19" Margin="0,0,0,12" />
                  <Border x:Name="HomeActivityNotice" CornerRadius="10" Padding="11,9"><StackPanel>
                    <TextBlock x:Name="HomeActivityStatus" Text="Comprobando" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock x:Name="HomeActivityDetail" Text="Preparando el estado de tu sesión." Foreground="{StaticResource Muted}" FontSize="12.5" LineHeight="19" Margin="0,4,0,0" /></StackPanel></Border>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="HomeSessionCount" Text="0" Foreground="{StaticResource Paper}" FontFamily="Georgia" FontSize="40" LineHeight="44" /><TextBlock Text="Pestañas conectadas" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,2,0,0" /></StackPanel></Border>
                  <TextBlock Text="ÚLTIMAS TRADUCCIONES" Style="{StaticResource Caption}" Margin="0,18,0,6" />
                  <StackPanel x:Name="RecentList" />
                  <TextBlock x:Name="RecentEmpty" Text="Todavía no hay páginas traducidas. Cuando YouJP transcriba un vídeo, aparecerá aquí." Foreground="{StaticResource Faint}" FontSize="12" LineHeight="18" />
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="ViewHistoryButton" Content="Ver historial  →" Style="{StaticResource Link}" />
                    <Button x:Name="ViewActivityButton" Content="Ver actividad  →" Style="{StaticResource Link}" Padding="0,6" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,4" Visibility="Collapsed">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,14" ClipToBounds="True">
            <Border.Background>
              <!-- Colores opacos: uno translúcido dejaría ver la tinta del fondo en vez de la tarjeta. -->
              <RadialGradientBrush Center="0.86,0.3" GradientOrigin="0.86,0.3" RadiusX="0.32" RadiusY="1.1"><GradientStop Color="#3F2524" Offset="0" /><GradientStop Color="#15161B" Offset="1" /></RadialGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="HECHO PARA TU EQUIPO" Foreground="{StaticResource Shu}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Hazlo tuyo." Foreground="{StaticResource Paper}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Elige cómo quieres escuchar y traducir. Puedes cambiarlo cuando quieras." Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,6,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Background="{StaticResource ShuDeep}" CornerRadius="12" Width="54" Height="54" Margin="14,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="調" FontFamily="Yu Mincho" Foreground="White" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Motor y traducción" FontWeight="SemiBold" FontSize="19" />
              <TextBlock Text="La opción automática es un buen punto de partida." Foreground="{StaticResource Muted}" Margin="0,6,0,22" LineHeight="21" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <TextBlock Text="Idioma / Language" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                <ComboBox x:Name="UiLanguageChoice" Width="160" SelectedIndex="0" AutomationProperties.Name="Idioma / Language">
                  <ComboBoxItem Content="Español" />
                  <ComboBoxItem Content="English" />
                </ComboBox>
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <Label Content="Procesamiento" Target="{Binding ElementName=DeviceChoice}" Padding="0,0,0,9" FontWeight="SemiBold" />
                  <ComboBox x:Name="DeviceChoice" SelectedIndex="0" AutomationProperties.Name="Procesamiento">
                    <ComboBoxItem Content="Automático" />
                    <ComboBoxItem Content="GPU NVIDIA" />
                    <ComboBoxItem Content="CPU" />
                  </ComboBox>
                  <TextBlock Text="La GPU acelera la transcripción. La CPU es compatible, pero tarda más." Foreground="{StaticResource Faint}" FontSize="12" Margin="0,10,0,0" LineHeight="19" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Label Content="Traducción" Target="{Binding ElementName=TranslationChoice}" Padding="0,0,0,9" FontWeight="SemiBold" />
                  <ComboBox x:Name="TranslationChoice" SelectedIndex="0" AutomationProperties.Name="Traducción">
                    <ComboBoxItem Content="Automática" />
                    <ComboBoxItem Content="Ollama (ya instalado)" />
                    <ComboBoxItem Content="NLLB local" />
                    <ComboBoxItem Content="Solo japonés" />
                  </ComboBox>
                  <TextBlock Text="El idioma de traducción se elige desde los ajustes de la extensión." Foreground="{StaticResource Faint}" FontSize="12" Margin="0,10,0,0" LineHeight="19" />
                </StackPanel>
              </Grid>
              <Border Background="#14F7D794" BorderBrush="#40F7D794" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,24,0,20">
                <TextBlock Text="※  La primera preparación descarga los modelos y diccionarios. Puede ocupar varios GB y tardar unos minutos." Foreground="{StaticResource Kin}" FontSize="12" LineHeight="20" />
              </Border>
              <WrapPanel>
                <Button x:Name="InstallButton" Content="Preparar / actualizar" Style="{StaticResource Primary}" Margin="0,0,10,8" />
                <Button x:Name="SetupActivityButton" Content="Ver progreso" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock x:Name="SetupHint" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,6,0,0" LineHeight="20" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="22,16">
            <Expander Header="Configuración avanzada" FontSize="13">
              <TextBlock Text="Si has personalizado el archivo .env o las variables de entorno, esos valores tienen prioridad sobre las opciones de esta ventana. Los cambios de arriba se aplican al pulsar Preparar / actualizar." Foreground="{StaticResource Muted}" Margin="22,12,0,0" LineHeight="21" />
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="ActivityPage" Grid.Row="1" Visibility="Collapsed" Margin="0,0,10,4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="ActivitySummary" Background="#14FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="ESTADO DEL MOTOR" Foreground="{StaticResource Shu}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock x:Name="ActivityStatus" Foreground="{StaticResource Paper}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ActivityDetail" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,5,0,0" LineHeight="19" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
              <TextBlock Text="REGISTRO RECIENTE" Style="{StaticResource Caption}" Margin="0" />
            </Border>
            <Border Grid.Row="1" Background="{StaticResource Inset}" CornerRadius="0,0,13,13" Padding="20,14,12,14">
              <TextBox x:Name="LogText" Style="{StaticResource ReadOnlyText}" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Registro de actividad" />
            </Border>
          </Grid>
        </Border>
        <WrapPanel Grid.Row="2" Margin="0,16,0,0">
          <Button x:Name="OpenLogsButton" Content="Abrir carpeta de registros" Margin="0,0,10,5" />
          <Button x:Name="CopyLogsButton" Content="Copiar registro" Margin="0,0,0,5" />
          <TextBlock x:Name="CopyFeedback" Foreground="{StaticResource Ok}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,5" />
        </WrapPanel>
      </Grid>

      <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed" Margin="0,0,10,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,14,0">
          <Grid>
            <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Páginas traducidas" />
            <TextBlock x:Name="HistoryEmpty" Text="Todavía no hay páginas traducidas. Cuando YouJP transcriba un vídeo, aparecerá aquí." Foreground="{StaticResource Faint}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="12,12" />
          </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,16,22,14">
              <StackPanel>
                <TextBlock x:Name="HistoryTitle" Foreground="{StaticResource Paper}" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HistoryMeta" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <TextBox x:Name="HistoryText" Grid.Row="1" Style="{StaticResource ReadOnlyText}" Foreground="{StaticResource Paper}" FontSize="14" Margin="22,14,12,14" AutomationProperties.Name="Frases de la página" />
          </Grid>
        </Border>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
          <Button x:Name="OpenVideoButton" Content="Abrir vídeo" Style="{StaticResource Primary}" Margin="0,0,10,5" />
          <Button x:Name="CopyHistoryButton" Content="Copiar texto" Margin="0,0,10,5" />
          <Button x:Name="RefreshHistoryButton" Content="Actualizar" Margin="0,0,10,5" />
          <Button x:Name="OpenHistoryFolderButton" Content="Abrir carpeta del historial" Margin="0,0,0,5" />
          <TextBlock x:Name="HistoryFeedback" Foreground="{StaticResource Ok}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,5" />
        </WrapPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="0,14,8,0"><TextBlock x:Name="FooterHint" Text="Al cerrar esta ventana, YouJP sigue disponible en la bandeja del sistema." Foreground="{StaticResource Faint}" FontSize="10.5" /></Grid>
    </Grid>
  </Grid>
</Window>
