# Copia este fichero a .env y ajusta lo que necesites.
# Todas las claves llevan prefijo YOUJP_ y se corresponden 1:1 con
# los campos de backend/youjp/config.py.

# --- ASR ---------------------------------------------------------------
# Modelos utiles en una RTX 2060 de 6 GB, de mas a menos preciso:
#   large-v3-turbo                      ~1,6 GB  recomendado
#   kotoba-tech/kotoba-whisper-v2.0-faster        especializado en japones
#   medium                              ~1,5 GB
#   small                               ~0,6 GB  solo si falta VRAM
YOUJP_ASR_MODEL=large-v3-turbo
YOUJP_ASR_DEVICE=cuda
YOUJP_ASR_COMPUTE_TYPE=int8_float16
YOUJP_ASR_BEAM_SIZE=1

# Cada cuanto se reejecuta Whisper sobre el buffer creciente.
# Es la palanca principal de latencia. Bajarlo acerca los parciales
# pero sube la carga de GPU.
YOUJP_MIN_CHUNK_S=0.8

# Longitud a partir de la cual se recorta la ventana por el ultimo
# punto confirmado. Sin recorte la inferencia se dispara.
YOUJP_BUFFER_TRIM_S=15.0

# --- VAD ---------------------------------------------------------------
YOUJP_VAD_THRESHOLD=0.5
YOUJP_VAD_RELEASE_THRESHOLD=0.35
YOUJP_VAD_MIN_SILENCE_MS=500

# --- traducción --------------------------------------------------------
YOUJP_MT_PROVIDER=llm
# Destino por defecto de llamadas directas a los proveedores: spa_Latn / eng_Latn.
# La extensión y el cliente replay envían su selección es/en por sesión.
YOUJP_MT_TARGET_LANG=spa_Latn

# --- servidor ----------------------------------------------------------
YOUJP_HOST=127.0.0.1
YOUJP_PORT=8770

# --- diagnostico -------------------------------------------------------
# DEBUG imprime cada pasada, cada confirmacion y cada descarte.
YOUJP_LOG_LEVEL=INFO
