FROM hf.co/tencent/Hy-MT2-1.8B-GGUF:Q4_K_M

# Exact single-user branch of Tencent's official chat_template.jinja.
# Source: https://huggingface.co/tencent/Hy-MT2-1.8B/blob/main/chat_template.jinja
# The candidate benchmark uses one user message and no default system prompt.
TEMPLATE """<｜hy_begin▁of▁sentence｜>{{ if .System }}{{ .System }}<｜hy_place▁holder▁no▁3｜>{{ end }}<｜hy_User｜>{{ .Prompt }}<｜hy_Assistant｜>{{ .Response }}"""
PARAMETER stop "<｜hy_place▁holder▁no▁2｜>"
PARAMETER stop "<｜hy_place▁holder▁no▁8｜>"
